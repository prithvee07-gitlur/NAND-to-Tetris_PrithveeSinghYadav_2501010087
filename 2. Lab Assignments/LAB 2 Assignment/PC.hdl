CHIP PC {
    IN in[16], load, inc, reset;
    OUT out[16];

    PARTS:
    Inc16(in=out, out=incremented);
    Mux16(a=out, b=incremented, sel=inc, out=withInc);
    Mux16(a=withInc, b=in, sel=load, out=withLoad);
    Mux16(a=withLoad, b=false, sel=reset, out=next);
    Or(a=load, b=inc, out=loadOrInc);
    Or(a=loadOrInc, b=reset, out=write);
    Register(in=next, load=write, out=out);
}
