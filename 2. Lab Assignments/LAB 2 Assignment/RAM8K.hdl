CHIP RAM8K {
    IN in[16], load, address[13];
    OUT out[16];

    PARTS:
    DMux8Way(in=load, sel=address[10..12], a=l0, b=l1, c=l2, d=l3,
             e=l4, f=l5, g=l6, h=l7);
    RAM1K(in=in, load=l0, address=address[0..9], out=r0);
    RAM1K(in=in, load=l1, address=address[0..9], out=r1);
    RAM1K(in=in, load=l2, address=address[0..9], out=r2);
    RAM1K(in=in, load=l3, address=address[0..9], out=r3);
    RAM1K(in=in, load=l4, address=address[0..9], out=r4);
    RAM1K(in=in, load=l5, address=address[0..9], out=r5);
    RAM1K(in=in, load=l6, address=address[0..9], out=r6);
    RAM1K(in=in, load=l7, address=address[0..9], out=r7);
    Mux8Way16(a=r0, b=r1, c=r2, d=r3, e=r4, f=r5, g=r6, h=r7,
              sel=address[10..12], out=out);
}
