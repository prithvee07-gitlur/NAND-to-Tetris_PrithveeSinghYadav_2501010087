// Computer for Hack Computer
// Capstone Project - Prithvee Singh Yadav (2501010087), K = 87
// Top-level chip: connects ROM32K, CPU, and Memory

CHIP Computer {
    IN reset;

    PARTS:
    // ROM32K holds the program (instruction memory)
    ROM32K(address=pc, out=instruction);

    // CPU executes instructions
    CPU(inM=memOut, instruction=instruction, reset=reset,
        outM=outM, writeM=writeM, addressM=addressM, pc=pc);

    // Memory (data memory: RAM + Screen + Keyboard)
    Memory(in=outM, load=writeM, address=addressM, out=memOut);
}
